---
import { Font } from 'astro:assets';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';

interface Props {
  /** Page title without the site name. Omit on the home page. */
  title?: string;
  description: string;
  /** Current section key for header aria-current ('grammar', 'glossary', ...). */
  currentKey?: string;
  /** Exclude from search engines (dev-only pages). */
  noindex?: boolean;
}

const SITE_NAME = 'Ukrainian, Clearly';
const { title, description, currentKey, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
// No canonical URL or sitemap: there is no real site origin yet (plan.md A14).
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <!-- Self-hosted via the Astro fonts API. Not preloaded: unicode-range
         subsets mean only the files a page actually needs are downloaded. -->
    <Font cssVariable="--font-noto-sans" />
    <Font cssVariable="--font-manrope" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader currentKey={currentKey} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
