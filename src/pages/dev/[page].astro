---
/**
 * DEV-ONLY component showcase and font glyph test: /dev/components/
 *
 * getStaticPaths returns no paths in production builds, so nothing under
 * /dev/ is ever written to dist/ (a plain components.astro page cannot be
 * excluded from a static build). Run `npm run dev` and open
 * http://localhost:4321/dev/components/.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleHeader from '../../components/ArticleHeader.astro';
import Example from '../../components/Example.astro';
import ExampleList from '../../components/ExampleList.astro';
import Note from '../../components/Note.astro';
import GrammarTable from '../../components/GrammarTable.astro';
import TopicPreview from '../../components/TopicPreview.astro';
import TopicNav from '../../components/TopicNav.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import PrevNext from '../../components/PrevNext.astro';
import Uk from '../../components/Uk.astro';

export const getStaticPaths = (() => {
  return import.meta.env.DEV ? [{ params: { page: 'components' } }] : [];
}) satisfies GetStaticPaths;

const glyphLines = ['Ґґ Єє Іі Її', 'м’ясо, п’ять', 'мо́ва, украї́нська'];
const fonts = [
  { name: 'Manrope (headings)', family: 'var(--font-heading)', weights: [600, 700, 800] },
  { name: 'Inter (body)', family: 'var(--font-body)', weights: [400, 500, 600, 700] },
];
const swatches = [
  ['--color-bg', '#FFFFFF'],
  ['--color-text', '#142238'],
  ['--color-text-muted', '#526176'],
  ['--color-blue', '#0057B7'],
  ['--color-blue-hover', '#004494'],
  ['--color-yellow', '#FFD700'],
  ['--color-blue-pale', '#EFF6FF'],
  ['--color-yellow-pale', '#FFF9D9'],
  ['--color-border', '#DCE4EE'],
  ['--color-border-strong', '#6B7A8F'],
];
const tocDemo = [
  { depth: 2, slug: 'glyphs', text: 'Font glyph test' },
  { depth: 2, slug: 'components', text: 'Components' },
  { depth: 3, slug: 'examples', text: 'Examples' },
];
---

<BaseLayout title="Component showcase (dev only)" description="Development-only component showcase." noindex>
  <div class="container showcase">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Dev' }, { label: 'Components' }]} />

    <ArticleHeader
      title="Component showcase"
      description="Development only: this page is not generated by npm run build. The fixture article is a draft at /grammar/fixture-article/."
      sectionLabel="Dev"
      prerequisites={[{ title: 'Fixture prerequisite page', href: '/grammar/fixture-prerequisite/' }]}
    />

    <section aria-labelledby="glyphs">
      <h2 id="glyphs">Font glyph test</h2>
      <p>
        Every line should render in the named font. The stress mark (U+0301) is not in Manrope; in headings it falls
        back to Inter by design (see astro.config.mjs).
      </p>
      {
        fonts.map((f) => (
          <div class="glyph-block" style={`font-family: ${f.family}`}>
            <p class="glyph-block__name">{f.name}</p>
            {f.weights.map((w) => (
              <div class="glyph-row" style={`font-weight: ${w}`}>
                <span class="glyph-row__weight">{w}</span>
                {glyphLines.map((line) => (
                  <span lang="uk">{line}</span>
                ))}
              </div>
            ))}
            <div class="glyph-row" style="font-style: italic">
              <span class="glyph-row__weight">italic</span>
              {glyphLines.map((line) => (
                <span lang="uk">{line}</span>
              ))}
            </div>
          </div>
        ))
      }
      <h3 class="glyph-heading" lang="uk">Ґґ Єє Іі Її · м’ясо · мо́ва</h3>
    </section>

    <section aria-labelledby="tokens">
      <h2 id="tokens">Colour tokens</h2>
      <ul class="swatches">
        {
          swatches.map(([name, hex]) => (
            <li>
              <span class="swatch" style={`background: var(${name})`} />
              <code>{name}</code> {hex}
            </li>
          ))
        }
      </ul>
      <p>
        <a class="button" href="#components">Primary button</a>
        <a class="button button--secondary" href="#components">Secondary button</a>
        <a href="#tokens">A body link</a>
      </p>
    </section>

    <section aria-labelledby="components" class="stack">
      <h2 id="components">Components</h2>

      <h3 id="examples">Examples</h3>
      <Example uk="мо́ва" en="language" translit="mova" />
      <Example en="the Ukrainian language" note="Slot form, with markup in the Ukrainian line.">
        украї́нська <strong>мо́ва</strong>
      </Example>
      <ExampleList title="Example list">
        <Example uk="м’ясо" en="meat" />
        <Example uk="п’ять" en="five" />
      </ExampleList>
      <p>Inline Ukrainian in prose: <Uk>мо́ва</Uk>, <Uk strong>п’ять</Uk>.</p>

      <h3>Notes</h3>
      <Note type="remember">A remember note.</Note>
      <Note type="mistake">A common mistake note.</Note>
      <Note>An info note.</Note>

      <h3>Grammar table</h3>
      <GrammarTable
        caption="Grammar table (data form)"
        headers={['Word', 'Meaning', 'Notes']}
        rows={[
          ['мо́ва', 'language', 'A long notes cell, to check wrapping and horizontal scrolling on narrow screens.'],
          ['п’ять', 'five', '—'],
        ]}
        ukColumns={[0]}
      />

      <h3>Topic previews</h3>
      <div class="preview-grid">
        <TopicPreview title="Card preview" description="One sentence describing the topic." href="#components" label="Grammar" />
        <TopicPreview title="Another card" description="Cards are gently rounded, with no heavy shadow." href="#components" />
      </div>
      <TopicPreview variant="row" title="Editorial row" description="The row variant, used in section lists." href="#components" />

      <h3>Topic nav, table of contents, previous/next</h3>
      <div class="nav-demo">
        <TopicNav
          heading="Grammar"
          headingHref="#components"
          links={[
            { label: 'Current page', href: '/dev/components/' },
            { label: 'Another page', href: '#components' },
          ]}
          currentHref="/dev/components/"
        />
        <TableOfContents headings={tocDemo} />
      </div>
      <TopicNav
        variant="disclosure"
        heading="Grammar"
        headingHref="#components"
        links={[{ label: 'Another page', href: '#components' }]}
      />
      <TableOfContents headings={tocDemo} variant="disclosure" />
      <PrevNext prev={{ title: 'Previous page', href: '#glyphs' }} next={{ title: 'Next page', href: '#tokens' }} />
    </section>
  </div>
</BaseLayout>

<style>
  .showcase {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    padding-top: var(--space-4);
  }

  section > * + * {
    margin-top: var(--space-4);
  }

  .stack > h3 {
    margin-top: var(--space-8);
  }

  .glyph-block {
    padding: var(--space-4) var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .glyph-block__name {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .glyph-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    font-size: 1.5rem;
    line-height: 1.5;
  }

  .glyph-row__weight {
    min-width: 4rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-style: normal;
    font-weight: 400;
    color: var(--color-text-muted);
    align-self: center;
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: var(--space-2);
    list-style: none;
    padding: 0;
  }

  .swatches li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }

  .swatch {
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
  }

  .button + .button,
  .button + a {
    margin-left: var(--space-4);
  }

  .preview-grid,
  .nav-demo {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }
</style>
