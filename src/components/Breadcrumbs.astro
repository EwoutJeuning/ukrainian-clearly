---
export interface Crumb {
  label: string;
  /** Omit for the current page (rendered with aria-current="page"). */
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {
      items.map((item) => (
        <li>
          {item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumbs {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    row-gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    line-height: var(--leading-snug);
  }

  li {
    display: inline-flex;
    align-items: center;
  }

  /* The separator trails its item, so a wrapped item never starts with "/". */
  li:not(:last-child)::after {
    content: '/';
    margin-inline: var(--space-2);
    color: var(--color-border-strong);
  }

  /* Keep a 24px minimum target (WCAG 2.5.8) without tall rows when wrapping. */
  a {
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
    padding-block: var(--space-1);
    color: var(--color-text-muted);
  }

  [aria-current='page'] {
    padding-block: var(--space-1);
  }

  a:hover {
    color: var(--color-blue-hover);
  }

  [aria-current='page'] {
    color: var(--color-text);
  }
</style>
