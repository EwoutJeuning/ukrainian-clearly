---
/**
 * An illustration from src/assets/illustrations/, recorded in images/manifest.json.
 * <Illustration src={kitchen} alt="A kitchen table with a cup, a plate and bread." caption="…" />
 * Use alt="" only when the image is purely decorative.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="illustration">
  <Image src={src} alt={alt} widths={[480, 768, 1200]} sizes="(max-width: 768px) 100vw, 720px" loading="lazy" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .illustration {
    margin: var(--space-6) 0;
  }
  .illustration :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
  }
  figcaption {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>
