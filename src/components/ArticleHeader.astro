---
import type { PageLink } from './PrevNext.astro';
import UkText from './UkText.astro';

interface Props {
  title: string;
  description: string;
  /** Small label above the title, e.g. "Grammar". */
  sectionLabel?: string;
  sectionHref?: string;
  prerequisites?: PageLink[];
}

const { title, description, sectionLabel, sectionHref, prerequisites = [] } = Astro.props;
---

<header class="article-header">
  {
    sectionLabel && (
      <p class="article-header__section">
        {sectionHref ? <a href={sectionHref}>{sectionLabel}</a> : sectionLabel}
      </p>
    )
  }
  <h1><UkText text={title} /></h1>
  <p class="article-header__lead">{description}</p>
  {
    prerequisites.length > 0 && (
      <div class="article-header__prereq">
        <p class="article-header__prereq-label">Read first:</p>
        <ul>
          {prerequisites.map((p) => (
            <li>
              <a href={p.href}>{p.title}</a>
            </li>
          ))}
        </ul>
      </div>
    )
  }
  <slot />
</header>

<style>
  .article-header {
    max-width: var(--measure);
  }

  .article-header__section {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-text-muted);
  }

  /* Small yellow marker: decorative accent paired with dark text. */
  .article-header__section::before {
    content: '';
    flex: none;
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 2px;
    background: var(--color-yellow);
    box-shadow: inset 0 0 0 1px rgb(20 34 56 / 0.15);
  }

  .article-header__section a {
    color: inherit;
    text-decoration: none;
  }

  .article-header__section a:hover {
    color: var(--color-blue-hover);
    text-decoration: underline;
  }

  .article-header__lead {
    margin-top: var(--space-4);
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .article-header__prereq {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-2);
    margin-top: var(--space-6);
    font-size: var(--text-sm);
  }

  .article-header__prereq-label {
    font-weight: var(--weight-semibold);
  }

  .article-header__prereq ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .article-header__prereq li:not(:last-child)::after {
    content: ',';
    color: var(--color-text-muted);
  }
</style>
